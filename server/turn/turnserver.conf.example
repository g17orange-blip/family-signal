# coturn configuration for the signal P2P messenger.
#
# Copy to /etc/turnserver.conf on the VPS (or use --config flag) and edit:
#   1. external-ip: set to your VPS public IP
#   2. realm:       set to a domain you control (or just the IP)
#   3. user:        set a username and a long random password
#   4. (optional)   put a Let's Encrypt cert path under cert/pkey for TLS
#
# coturn provides both STUN (free public service) and TURN (authenticated
# relay) on the same daemon. The signaling server can run on the same VPS
# without conflicts — coturn uses UDP/TCP 3478 and 5349, signaling uses 8080.

# --- Network --------------------------------------------------------------

listening-port=3478
tls-listening-port=5349

# Public IP of the VPS. If the box is behind 1:1 NAT (rare on VPS), use
# `external-ip=PUBLIC/PRIVATE` instead. Leaving this unset breaks relay.
external-ip=REPLACE_WITH_VPS_PUBLIC_IP

# Range of UDP ports used for relayed media. Open these in the firewall.
min-port=49152
max-port=65535

# --- Authentication -------------------------------------------------------

# Long-term credentials. For two known users this is fine — both clients
# ship with the same TURN username/password baked into their config.
lt-cred-mech
realm=REPLACE_WITH_DOMAIN_OR_IP
user=signaluser:REPLACE_WITH_LONG_RANDOM_PASSWORD

# --- Hardening ------------------------------------------------------------

# Refuse to relay to loopback / private ranges — prevents the TURN server
# being abused as a proxy into someone's internal network.
no-loopback-peers
no-multicast-peers
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=127.0.0.0-127.255.255.255

# Cap total bandwidth and per-session bandwidth (kbps). Two users on a
# single relay never need more than a few Mbps.
total-quota=100
user-quota=12
max-bps=2000000

# --- TLS (optional but recommended) ---------------------------------------

# Uncomment and point at your Let's Encrypt cert to enable TURNS on 5349.
# cert=/etc/letsencrypt/live/example.com/fullchain.pem
# pkey=/etc/letsencrypt/live/example.com/privkey.pem

# --- Logging --------------------------------------------------------------

log-file=stdout
no-stdout-log
simple-log
